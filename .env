# Local-only env. Vite reads THIS file (.env), not .env.example.
# .env.example is the committed template/reference.
#
# Anything starting with VITE_ is INLINED INTO THE PUBLISHED JS BUNDLE.
# Treat the values here as visible to anyone with DevTools on the deployed site.
#
# IMPORTANT: Vite uses dotenv-expand, which expands `$VAR` references in
# env values. JSONBin bcrypt keys start with `$2a$10$...`, so EVERY `$`
# MUST be escaped with a backslash (`\$`). Quoting alone is not enough.

# JSONBin Bin ID — non-secret (it's in the bin URL).
VITE_JSONBIN_ID=6a03fab1c0954111d8169292

# JSONBin Access Key (Read permission) — designed to be embedded.
VITE_JSONBIN_ACCESS_KEY=\$2a\$10\$sGCWBBz.7qVN2wuzhf79JeS659wSWxTGq8unnkat79khYFDY.tkjS

# JSONBin Master Key (READ + WRITE). Rotate in JSONBin if exposed.
VITE_JSONBIN_MASTER_KEY=\$2a\$10\$nQC629GndW9LEVZ5Gd4nPOD/f2pDiyowKQ63hxymRxsNjybCs91/C
