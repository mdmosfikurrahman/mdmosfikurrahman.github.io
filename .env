# Anything starting with VITE_ is INLINED INTO THE PUBLISHED JS BUNDLE.
# JSONBin bcrypt-style keys contain `$` which Vite/dotenv-expand will expand —
# every `$` MUST be escaped with a backslash (`\$`).

# JSONBin Bin ID — non-secret (it's in the bin URL).
VITE_JSONBIN_ID=6a03fab1c0954111d8169292

# JSONBin Access Key — designed to be embedded. Escape each `$` with `\`.
VITE_JSONBIN_ACCESS_KEY=\$2a\$10\$sGCWBBz.7qVN2wuzhf79JeS659wSWxTGq8unnkat79khYFDY.tkjS

# JSONBin Master Key (READ + WRITE). Same escaping rule.
VITE_JSONBIN_MASTER_KEY=\$2a\$10\$nQC629GndW9LEVZ5Gd4nPOD/f2pDiyowKQ63hxymRxsNjybCs91/C
