# Local-only env (gitignored).
#
# Anything starting with VITE_ is INLINED INTO THE PUBLISHED JS BUNDLE.
# Treat the values here as "visible to anyone who opens DevTools on the
# deployed site". Don't put anything truly secret here.

# JSONBin Bin ID — non-secret (it's in the bin URL).
VITE_JSONBIN_ID=6a03fab1c0954111d8169292

# JSONBin Access Key (Read permission) — designed to be embedded.
# Create one in JSONBin → API Keys with Read access on the bin above,
# then paste it here. Leave blank if the bin is public.
VITE_JSONBIN_ACCESS_KEY=$2a$10$sGCWBBz.7qVN2wuzhf79JeS659wSWxTGq8unnkat79khYFDY.tkjS

# JSONBin Master Key (READ + WRITE). WARNING: embedding this means anyone
# can inspect the bundle and overwrite the bin. The portfolio uses this
# only to flip a template choice, so the blast radius is small — but if
# you're concerned, leave this blank and paste the key in /admin/templates
# once per device. The admin page tries the env value first, then falls
# back to whatever you pasted into localStorage.
VITE_JSONBIN_MASTER_KEY=$2a$10$nQC629GndW9LEVZ5Gd4nPOD/f2pDiyowKQ63hxymRxsNjybCs91/C
